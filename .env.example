# 1. 数据库连接（本地用 SQLite 零配置起步）
#    生产切 PostgreSQL：把 schema.prisma 的 provider 改为 "postgresql"，
#    URL 形如 "postgresql://USER:PASSWORD@HOST:5432/inkstone?schema=public"
DATABASE_URL="file:./dev.db"

# 2. 会话/令牌签名密钥，必填。生成：npx auth secret  或  openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# 3. 站点地址（v5 用 AUTH_URL；NEXTAUTH_URL 亦被兼容）。本地可省略
AUTH_URL="http://localhost:3000"

# 4. 邮件占位，可选。sendVerificationRequest 已重写，不会真的发邮件
EMAIL_FROM="Inkstone <noreply@inkstone.dev>"
